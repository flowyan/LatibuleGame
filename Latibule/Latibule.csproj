<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Configurations>Release;Debug</Configurations>
        <Platforms>AnyCPU</Platforms>
        <TargetFramework>net10.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <None Include="Assets\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Assets\sound\misc\meow.ogg">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Assets\sound\misc\scarletfire.ogg">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Assets\sound\misc\sleepphonk.ogg">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Assets\sound\music\scarletfire.ogg">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AssimpNetter" Version="6.0.6" />
        <PackageReference Include="FontStashSharp.PlatformAgnostic" Version="1.6.2" />
        <PackageReference Include="ImGui.NET" Version="1.91.6.1"/>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="JoltPhysicsSharp" Version="2.26.0" />
        <PackageReference Include="OpenTK" Version="4.9.4"/>
        <PackageReference Include="SDL3-CS" Version="3.4.20" />
        <PackageReference Include="SDL3-CS.Linux" Version="3.4.20" />
        <PackageReference Include="SDL3-CS.Linux.Mixer" Version="3.2.4.15" />
        <PackageReference Include="SixLabors.ImageSharp" Version="4.1.4" />
        <PackageReference Include="StbImageSharp" Version="2.30.16" />
        <PackageReference Include="SteamAudio.NET" Version="4.6.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Engine\Engine.csproj" />
    </ItemGroup>
</Project>
